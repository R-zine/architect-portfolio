{
  "name": "architect-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node .husky/install.ts",
    "assets:build": "node scripts/optimize-images.ts",
    "assets:model": "gltf-transform optimize assets/model-source/model.gltf public/model.glb --compress meshopt --texture-compress webp --texture-size 1024",
    "dev": "yarn assets:build && vite",
    "build": "yarn assets:build && vite build",
    "preview": "vite preview",
    "test": "yarn assets:build && vitest run",
    "test:watch": "yarn assets:build && vitest",
    "test:coverage": "yarn assets:build && vitest run --coverage",
    "test:e2e": "yarn build && node scripts/run-playwright.ts",
    "test:a11y": "yarn build && node scripts/run-playwright.ts --grep @a11y",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "yarn lint && yarn typecheck && yarn test:coverage && yarn build",
    "verify:commit": "yarn check",
    "audit": "yarn npm audit --all --recursive --no-deprecations"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "three": "^0.185.1"
  },
  "dependenciesMeta": {
    "@parcel/watcher": {
      "built": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.5.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "sass": "^1.103.1",
    "sharp": "^0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
